<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
  <title>Terrence's Little Zoo Helpers</title>
  <script src="https://cdn.jsdelivr.net/npm/phaser@3/dist/phaser.min.js"></script>
  <style>
    body { margin: 0; background: #cfe8c9; }
    canvas { display: block; margin: auto; }
  </style>
</head>
<body>

<script>
const config = {
  type: Phaser.AUTO,
  width: 390,
  height: 844,
  backgroundColor: '#cfe8c9',
  scene: { preload, create }
};

const game = new Phaser.Game(config);

function preload() {
  this.load.image('elephant', 'images/elephant.png');
  this.load.image('sponge', 'images/sponge.png');
  this.load.image('background', 'images/background.png');
  this.load.audio('elephantSound', 'audio/elephant.mp3');
  this.load.audio('narratorStart', 'audio/narrator_start.mp3');
  this.load.audio('narratorSuccess', 'audio/narrator_success.mp3');
}

function create() {
  // Background
  this.add.image(195, 422, 'background').setScale(0.8);

  // Elephant
  const elephant = this.add.image(195, 450, 'elephant').setScale(0.6);

  // Sponge
  const sponge = this.add.image(195, 700, 'sponge').setScale(0.4);
  sponge.setInteractive({ draggable: true });

  // Play starting narration
  this.sound.play('narratorStart');

  this.input.setDraggable(sponge);

  this.input.on('drag', (pointer, gameObject, dragX, dragY) => {
    gameObject.x = dragX;
    gameObject.y = dragY;
  });

  this.input.on('dragend', (pointer, gameObject) => {
    const distance = Phaser.Math.Distance.Between(
      gameObject.x, gameObject.y,
      elephant.x, elephant.y
    );

    if (distance < 150) {
      this.sound.play('elephantSound');
      this.sound.play('narratorSuccess');
      this.tweens.add({
        targets: elephant,
        scale: 0.65,
        yoyo: true,
        duration: 300
      });
    }

    gameObject.x = 195;
    gameObject.y = 700;
  });
}
</script>

</body>
</html>